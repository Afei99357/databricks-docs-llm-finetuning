SOURCE_SQLITE_PATH=./data/local.sqlite
GENERATOR_BASE_URL=http://127.0.0.1:1234/v1
GENERATOR_MODEL=unsloth/Muse-Glimmer-30B-GGUF:UD-Q4_K_XL
GENERATOR_API_KEY=local
# Optional independent judge for step 07b. Falls back to GENERATOR_* when unset.
JUDGE_BASE_URL=http://127.0.0.1:1234/v1
JUDGE_MODEL=replace-with-an-independent-judge-model
JUDGE_API_KEY=local
QUESTION_WORKERS=6
ANSWER_WORKERS=6
EVALUATION_WORKERS=6
# Comma-separated final training Q&A databases. Add the independent-Q&A path
# before you generate the evaluation benchmark.
FINAL_TRAINING_DATABASES=artifacts/qa_page_aware/generation.sqlite,artifacts/qa_independent/generation.sqlite
