# Documentation corpus produced by the sibling RAG project.
SOURCE_SQLITE_PATH=../databricks_docs_rag/data/local.sqlite

# Muse is the local generator for QA creation and RAG reasoning.
GENERATOR_BASE_URL=http://localhost:1234/v1
GENERATOR_MODEL=unsloth/Muse-Glimmer-30B-GGUF:UD-Q4_K_XL
GENERATOR_API_KEY=local
QUESTION_WORKERS=6
ANSWER_WORKERS=6

# Independent Qwen judge for step 08. Do not point this at Muse because Muse
# powers the RAG application being evaluated.
JUDGE_BASE_URL=http://intuition.local:1234/v1
JUDGE_MODEL=qwen-3.8-27b
JUDGE_API_KEY=local

# Comma-separated final training Q&A databases. Add the independent-Q&A path
# before you generate the evaluation benchmark.
FINAL_TRAINING_DATABASES=artifacts/qa_page_aware/generation.sqlite,artifacts/qa_independent/generation.sqlite
